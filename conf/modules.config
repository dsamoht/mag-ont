/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.

    Output paths are declared in the `output` block of main.nf (Nextflow workflow
    outputs), not with publishDir directives.
----------------------------------------------------------------------------------------
*/

process {

    // ---------------------------------------------------------------------- QC
    withName: 'PORECHOP_ABI' {
        ext.args = '--ab_initio --discard_middle'
    }
    withName: 'CHOPPER' {
        ext.args = { "-l ${params.chopper_minlength} -q ${params.chopper_minq}" }
    }
    withName: 'NANOPLOT_RAW' {
        ext.prefix = { "${meta.id}_raw" }
    }
    withName: 'NANOPLOT_QC' {
        ext.prefix = { "${meta.id}_qc" }
    }

    // ---------------------------------------------------------------- Assembly
    withName: 'FLYE' {
        ext.args = '--meta'
    }
    withName: 'MEDAKA' {
        ext.args = { "-m ${params.medaka_model}" }
    }

    // ----------------------------------------------------------------- Mapping
    withName: 'MINIMAP' {
        ext.args = { "-ax ${params.minimap2_preset}" }
    }

    // -------------------------------------------------------------- Annotation
    withName: 'PYRODIGAL' {
        ext.args = '-p meta'
    }

    // ----------------------------------------------------------------- Binning
    withName: 'METABAT' {
        ext.args = ''
    }
    withName: 'COMEBIN' {
        ext.args = ''
    }
    withName: 'SEMIBIN' {
        ext.args = ''
    }
    withName: 'DASTOOL' {
        ext.args = '--score_threshold=-9999'
    }

    // ------------------------------------------------------------- Bin QC / tax
    withName: 'CHECKM' {
        ext.args = ''
    }
    withName: 'GTDBTK' {
        ext.args = '--skip_ani_screen'
    }

    // ---------------------------------------------------------------- Coverage
    withName: 'COVERM_CONTIG' {
        ext.args = '--methods mean trimmed_mean covered_fraction'
    }
    withName: 'COVERM_GENOME' {
        ext.args = '--methods mean trimmed_mean covered_fraction'
    }

    // ------------------------------------------------------------------ Report
    withName: 'MULTIQC' {
        ext.args = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
    }
}
