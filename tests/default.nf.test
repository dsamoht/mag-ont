nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    tag "pipeline"

    test("-profile test") {

        when {
            params {
                outdir = "$outputDir"
            }
        }

        then {
            // No snapshot. `ont_test4` is the only group without a pre-made assembly, so it is
            // the only one that runs Flye, and Flye is not reproducible: five runs of this test
            // on one commit, with the same containers, produced five different assemblies.
            // Everything derived from it differs in turn, down to the number of bins and so the
            // file names, and CoverM's genome statistics are unstable in the other groups too.
            assert workflow.success
        }
    }

    test("-profile test --binning_map_mode all") {

        when {
            params {
                input            = "${projectDir}/tests/data/samplesheet_cobin.csv"
                binning_map_mode = "all"
                outdir           = "$outputDir"
            }
        }

        then {
            // Two pre-assembled long-read groups, so no Flye and nothing unstable to
            // snapshot either. Both assemblies must collect a BAM from both samples.
            assert workflow.success
            assert path("$outputDir/group_ont_test3/mapping/samtools/test3.bam").exists()
            assert path("$outputDir/group_ont_test3/mapping/samtools/test_genome.bam").exists()
            assert path("$outputDir/group_test_genome/mapping/samtools/test3.bam").exists()
            assert path("$outputDir/group_test_genome/mapping/samtools/test_genome.bam").exists()
        }
    }
}
